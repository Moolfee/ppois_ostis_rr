subject_domain_of_transport_accessibility
<- concept_subject_domain;
=> nrel_main_idtf:
    [Предметная область транспортной доступности районов города Новосибирска]
    (*
        <- lang_ru;;
    *);
    [Subject domain of transport accessibility of Novosibirsk districts]
    (*
        <- lang_en;;
    *);
<= nrel_private_subject_domain: 
    subject_domain_of_urban_planning;
=> nrel_private_subject_domain:
    subject_domain_of_relations;
    subject_domain_of_structures;
-> rrel_maximum_studied_object_class:
    concept_transport_accessibility_indicator;
-> rrel_not_maximum_studied_object_class:
    concept_transport_infrastructure_element;
    concept_territory;
    concept_public_transport_route;
-> rrel_explored_relation:
    nrel_transport_accessibility_level;
    nrel_connects_districts;
=> nrel_note:
    [Данная предметная область описывает доступность общественного транспорта в разных районах Новосибирска.]
    (*
        <- lang_ru;;
    *);
    [This subject area describes the availability of public transport in different districts of Novosibirsk.]
    (*
        <- lang_en;;
    *);;