@search_schema_by_validator = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._validator <-_ concept_metadata_validator);;
            nrel_validator _-> (.._data_record _=> .._validator);;
            @output_param1 = (.._data_record <-_ concept_metadata_record);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *);
    rrel_next_template: {
        rrel_init_template: {
            rrel_template: [*
                @input_param1 = (.._data_record <-_ concept_metadata_record);;
                nrel_conforms_to _-> (.._data_record _=> .._schema);;
                @output_param1 = (.._schema <-_ concept_metadata_schema);;
            *];
            rrel_template_input_params: {
                @input_param1
            };
            rrel_template_output_params: {
                @output_param1
            }
        } (* <- nrel_search_set_template;; *);
        rrel_next_template: {
            rrel_init_template: {
                rrel_template: [*
                    @input_param1 = (.._schema <-_ concept_metadata_schema);;
                    nrel_main_idtf _-> (.._schema _=> .._main_idtf);;
                    @output_param1 = (.._main_idtf <-_ lang_ru);;
                *];
                rrel_template_input_params: {
                    @input_param1
                };
                rrel_template_output_params: {
                    @output_param1
                }
            } (* <- nrel_search_template;; *)
        } (* <- nrel_fixed_search_strategy_template;; *)
    } (* <- nrel_fixed_search_strategy_template;; *)
};;

@search_schema_by_validator
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска схемы по валидатору]
    (*
        <- lang_ru;;
    *);;
