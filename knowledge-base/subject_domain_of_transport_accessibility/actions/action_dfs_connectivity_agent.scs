action_check_DFS_connectivity
<- sc_node_class;
<- concept_class;
=> nrel_main_idtf:
    [действие проверки связности графа через DFS]
    (* 
        <- lang_ru;;
    *);
    [action to check graph connectivity via DFS]
    (*
        <- lang_en;;
    *);
<= nrel_inclusion:
    concept_route_action;;

..dfs_connectivity_action
    <- action_check_DFS_connectivity;
    <- action_initiated;
    -> rrel_1: ..transport_graph;;

..dfs_connectivity_action
    => nrel_result: [*
        ..transport_graph
            => nrel_unreachable_districts: ..unreachable_set;;
    *];;
