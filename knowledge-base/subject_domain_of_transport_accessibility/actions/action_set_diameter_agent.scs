action_calculate_diameter
<- sc_node_class;
<- concept_class;
=> nrel_main_idtf:
    [действие рассчёта диаметра транспортной сети]
    (* 
        <- lang_ru;;
    *);
    [action to calculate transport network diameter]
    (*
        <- lang_en;;
    *);
<= nrel_inclusion:
    concept_route_action;;

..diameter_action
    <- action_calculate_diameter;
    <- action_initiated;
    -> rrel_1: ..transport_graph;;

..diameter_action
    => nrel_result: [*
        ..transport_graph
            => nrel_diameter: ..diameter_value;;
    *];;
